#cloud-config

hostname: ${vm_hostname}
preserve_hostname: false
package_update: true

users:
  - default
  - name: ${vm_username}
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

%{ if rhel_activation_key != "" && rhel_org_id != "" ~}
rh_subscription:
  activation-key: ${rhel_activation_key}
  org: ${rhel_org_id}
  auto-attach: true
%{ endif ~}

packages:
  - qemu-guest-agent
  - curl
  - wget
  - vim
  - git
  - unzip
  - bash-completion
  - tcpdump
  - traceroute
  - nmap
  - tmux

timezone: ${timezone}

runcmd:
  - systemctl enable --now qemu-guest-agent
  - |
    if [ -f /etc/debian_version ]; then
      apt-get install -y iputils-ping netcat-openbsd
    elif [ -f /etc/redhat-release ]; then
      dnf install -y iputils nmap-ncat bash-completion
      echo '[ -f /etc/profile.d/bash_completion.sh ] && . /etc/profile.d/bash_completion.sh' >> /etc/bashrc
    fi
%{ if vm_swap_size > 0 ~}
  - |
    fallocate -l ${vm_swap_size}M /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo '/swapfile none swap sw 0 0' >> /etc/fstab
%{ endif ~}
