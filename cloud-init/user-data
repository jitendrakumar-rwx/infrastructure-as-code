#cloud-config

hostname: ${vm_hostname}
preserve_hostname: false
%{ if rhel_activation_key == "" ~}
package_update: true
%{ endif ~}

# Prevent background auto-updates from locking package managers during provisioning
bootcmd:
  - [ systemctl, mask, unattended-upgrades.service, apt-daily-upgrade.timer, apt-daily.timer, dnf-makecache.timer ]
  - [ systemctl, stop, unattended-upgrades.service, apt-daily-upgrade.timer, apt-daily.timer, dnf-makecache.timer ]

users:
  - default
  - name: ${vm_username}
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}



%{ if rhel_activation_key == "" ~}
packages:
  - qemu-guest-agent
  - curl
  - wget
  - vim
  - git
  - unzip
  - bash-completion
  - tcpdump
  - traceroute
  - nmap
  - tmux
%{ endif ~}

timezone: ${timezone}

runcmd:
  - hostnamectl set-hostname "${vm_hostname}"
  - |
    if [ -f /etc/debian_version ]; then
      systemctl enable --now qemu-guest-agent
      apt-get install -y iputils-ping netcat-openbsd
    elif [ -f /etc/redhat-release ]; then
%{ if rhel_activation_key != "" && rhel_org_id != "" ~}
      subscription-manager register --org="${rhel_org_id}" --activationkey="${rhel_activation_key}" --force
%{ endif ~}
      dnf install -y qemu-guest-agent curl wget vim git unzip bash-completion tcpdump traceroute nmap tmux iputils nmap-ncat insights-client
      systemctl enable --now qemu-guest-agent
      echo '[ -f /etc/profile.d/bash_completion.sh ] && . /etc/profile.d/bash_completion.sh' >> /etc/bashrc
      if command -v insights-client >/dev/null 2>&1; then
        sudo insights-client --register
      fi
    fi
%{ if vm_swap_size > 0 ~}
  - |
    fallocate -l ${vm_swap_size}M /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo '/swapfile none swap sw 0 0' >> /etc/fstab
%{ endif ~}
