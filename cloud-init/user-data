#cloud-config

hostname: ${vm_hostname}
preserve_hostname: false
package_update: true

# Prevent Ubuntu background auto-updates from locking apt during provisioning
bootcmd:
  - [ systemctl, mask, unattended-upgrades.service, apt-daily-upgrade.timer, apt-daily.timer ]
  - [ systemctl, stop, unattended-upgrades.service, apt-daily-upgrade.timer, apt-daily.timer ]

users:
  - default
  - name: ${vm_username}
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}



packages:
  - qemu-guest-agent
  - curl
  - wget
  - vim
  - git
  - unzip
  - bash-completion
  - tcpdump
  - traceroute
  - nmap
  - tmux

timezone: ${timezone}

runcmd:
  - hostnamectl set-hostname "${vm_hostname}"
  - systemctl enable --now qemu-guest-agent
  - |
    if [ -f /etc/debian_version ]; then
      apt-get install -y iputils-ping netcat-openbsd
    elif [ -f /etc/redhat-release ]; then
%{ if rhel_activation_key != "" && rhel_org_id != "" ~}
      subscription-manager register --org="${rhel_org_id}" --activationkey="${rhel_activation_key}" --force
%{ endif ~}
      dnf install -y iputils nmap-ncat bash-completion insights-client
      echo '[ -f /etc/profile.d/bash_completion.sh ] && . /etc/profile.d/bash_completion.sh' >> /etc/bashrc
      insights-client --register
    fi
%{ if vm_swap_size > 0 ~}
  - |
    fallocate -l ${vm_swap_size}M /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo '/swapfile none swap sw 0 0' >> /etc/fstab
%{ endif ~}
